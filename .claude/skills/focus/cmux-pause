#!/usr/bin/python3
"""Pauses a cmux workspace: stores the end time and shows a pill in the sidebar.

Usage:
  cmux-pause <30m|4h|2d|1w>                  Pause the current workspace for a duration.
  cmux-pause until <when>                    Pause until a time. <when> is one of:
                                               18:30            today, or tomorrow if past
                                               tomorrow [9:00]
                                               mon [10:00]      the next Monday
                                               2026-11-02 [9:00]
                                             A day with no time means 09:00.
  cmux-pause off                             End the pause of the current workspace.
  cmux-pause list                            List the active pauses.
  cmux-pause sync                            Remove ended pauses, and update every pill.
  --workspace <id|ref>                       Act on this workspace, not $CMUX_WORKSPACE_ID.

The pill says "paused until 18:30" on the last day of the pause, else "paused until 2 Nov".
focus.py reads the same state file, so a paused workspace goes to the bottom of /focus.
"""
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timedelta
from pathlib import Path

STATE = Path(os.environ.get("CMUX_PAUSE_STATE", Path.home() / ".local/state/cmux-pause/pauses.json"))
CMUX = os.environ.get("CMUX_PAUSE_CMUX", "cmux")
KEY = "pause"
DAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
DEFAULT_TIME = (9, 0)


def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def now():
    return datetime.now().astimezone()


def cmux(*args, check=True):
    out = subprocess.run([CMUX, *args], capture_output=True, text=True, timeout=20,
                         env={**os.environ, "CMUX_QUIET": "1"})
    if check and out.returncode != 0:
        die(f"cmux {' '.join(args)} failed: {out.stderr.strip() or out.stdout.strip()}")
    return out


def load():
    try:
        return json.loads(STATE.read_text())
    except FileNotFoundError:
        return {}


def save(state):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=STATE.parent)
    with os.fdopen(fd, "w") as f:
        json.dump(state, f, indent=1, sort_keys=True)
    os.replace(tmp, STATE)


def workspace_id(ref):
    """A ref (workspace:3), index, or UUID -> the workspace UUID, upper case."""
    if ref is None:
        ref = os.environ.get("CMUX_WORKSPACE_ID")
        if not ref:
            die("no workspace: run this inside cmux, or pass --workspace <id|ref>")
    if re.fullmatch(r"[0-9A-Fa-f-]{36}", ref):
        return ref.upper()
    for w in json.loads(cmux("--json", "workspace", "list").stdout).get("workspaces", []):
        if ref in (w.get("ref"), str(w.get("index"))):
            return w["id"].upper()
    die(f"workspace {ref} not found")


def at_time(day, text):
    if not text:
        h, m = DEFAULT_TIME
    else:
        mt = re.fullmatch(r"(\d{1,2})(?::(\d{2}))?", text)
        if not mt or int(mt.group(1)) > 23 or int(mt.group(2) or 0) > 59:
            die(f"bad time '{text}': use 9 or 18:30")
        h, m = int(mt.group(1)), int(mt.group(2) or 0)
    return day.replace(hour=h, minute=m, second=0, microsecond=0)


def parse_until(words):
    if not words:
        die("usage: cmux-pause until <18:30 | tomorrow [9:00] | mon [10:00] | 2026-11-02 [9:00]>")
    first, rest = words[0].lower(), (words[1] if len(words) > 1 else None)
    t = now()
    if re.fullmatch(r"\d{1,2}(:\d{2})?", first):
        end = at_time(t, first)
        return end if end > t else end + timedelta(days=1)
    if first in ("today", "tomorrow"):
        return at_time(t + timedelta(days=first == "tomorrow"), rest)
    if first[:3] in DAYS:
        ahead = (DAYS.index(first[:3]) - t.weekday()) % 7 or 7
        return at_time(t + timedelta(days=ahead), rest)
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", first):
        return at_time(datetime.strptime(first, "%Y-%m-%d").replace(tzinfo=t.tzinfo), rest)
    die(f"bad time '{' '.join(words)}'")


def parse_duration(text):
    m = re.fullmatch(r"(\d+)([mhdw])", text.lower())
    if not m:
        return None
    n, unit = int(m.group(1)), m.group(2)
    return now() + {"m": timedelta(minutes=n), "h": timedelta(hours=n),
                    "d": timedelta(days=n), "w": timedelta(weeks=n)}[unit]


def label(end):
    if end.date() == now().date():
        return f"paused until {end:%H:%M}"
    return f"paused until {end.day} {end:%b}"


def show(ws, end):
    cmux("set-status", KEY, label(end), "--icon", "pause.circle.fill", "--color", "#8E8E93",
         "--priority", "90", "--workspace", ws, check=False)


def hide(ws):
    cmux("clear-status", KEY, "--workspace", ws, check=False)


def timer(end):
    """Run sync when the pause ends, and at midnight before its last day, so the pill text
    changes to the exact time on that day. A restart loses the timers; any sync fixes it."""
    points = [end]
    midnight = end.replace(hour=0, minute=0, second=0, microsecond=0)
    if midnight > now():
        points.append(midnight)
    for p in points:
        delay = max(1, int((p - now()).total_seconds()) + 1)
        subprocess.Popen(["/bin/sh", "-c", f"sleep {delay}; exec '{os.path.realpath(__file__)}' sync"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def sync(state):
    t = now()
    for ws, entry in list(state.items()):
        end = datetime.fromisoformat(entry["until"])
        if end <= t:
            del state[ws]
            hide(ws)
        else:
            show(ws, end)
    save(state)


def main(argv):
    ref = None
    if "--workspace" in argv:
        i = argv.index("--workspace")
        if i + 1 >= len(argv):
            die("--workspace needs a value")
        ref = argv[i + 1]
        argv = argv[:i] + argv[i + 2:]
    if not argv:
        print(__doc__.strip())
        return
    state = load()
    cmd = argv[0].lower()

    if cmd == "sync":
        sync(state)
        return
    if cmd == "list":
        sync(state)
        for ws, e in sorted(state.items(), key=lambda kv: kv[1]["until"]):
            print(f"{ws}  until {datetime.fromisoformat(e['until']).astimezone():%Y-%m-%d %H:%M %Z}")
        if not state:
            print("no active pauses")
        return

    ws = workspace_id(ref)
    if cmd == "off":
        print("pause ended" if state.pop(ws, None) else "this workspace was not paused")
        hide(ws)
        save(state)
        return

    end = parse_until(argv[1:]) if cmd == "until" else parse_duration(cmd)
    if end is None:
        die(f"unknown command '{argv[0]}'. Use a duration (4h), until <when>, off, list, or sync")
    if end <= now():
        die("the end time is in the past")
    state[ws] = {"until": end.isoformat(timespec="seconds")}
    save(state)
    show(ws, end)
    timer(end)
    print(f"paused until {end:%a %Y-%m-%d %H:%M %Z}")


if __name__ == "__main__":
    main(sys.argv[1:])
